# Python
__pycache__/
*.pyc
.venv/

# Raw experiment data can get large
data/raw/*
data/processed/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*

# Local system files
.DS_Store
Thumbs.db

# Secrets
.env
secrets/

